{
  "name": "zdog-ts",
  "version": "1.0.0",
  "description": "Zdog written in TypeScript",
  "bugs": {
    "url": "https://github.com/AGS1130/zdog-ts/issues"
  },
  "license": "MIT",
  "author": "Gregory Salinas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AGS1130/zdog-ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist node_modules",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fresh": "bun clean && bun install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "lefthook install",
    "version": "bun changeset version && bun postprocess-changelogs.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@happy-dom/global-registrator": "21.0.3",
    "@types/bun": "1.4.3",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^14.18.0 || >=16.10.0"
  }
}
